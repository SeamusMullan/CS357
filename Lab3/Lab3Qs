Section CoqLab02.

Context (A B C : Prop).

(***************************************************)
(* And / Or *)

Lemma q1 : (A /\ B) /\ C -> A /\ (B /\ C).
Proof.
  intros.
  split.
  apply H.
  split.
  apply H.
  apply H.
Qed.

Lemma q2 : ((A /\ B) -> C) -> (A -> (B -> C)).
Proof.
  intros.
  apply H.
  split.
  apply H0.
  apply H1.
Qed.

Lemma q3 : (A \/ B) \/ C -> A \/ (B \/ C).
Proof.
  intros.
  induction H.
  destruct H.
  left.
  apply H.
  right.
  left.
  apply H.
  right.
  right.
  apply H.
Qed.

Lemma q4 : ((A \/ B) -> C) -> (A -> (B -> C)).
Proof.
  intros.
  apply H.
  left.
  apply H0.
Qed.

(***************************************************)
(* Negation *)

Axiom LEM : forall P : Prop, P \/ ~P.

Lemma q5 : (~A \/ B) -> (A -> B).
Proof.
  intros.
  induction H.
  destruct H.
  apply H0.
  apply H.
  
  
Qed.

Lemma q6 : (A -> B) -> (~B -> ~A).
Proof.
  intros.
  red.
  intro.
  apply H0.
  apply H.
  apply H1.
Qed.

Lemma q7 : ~(A /\ ~A).
Proof.
  intro.
  destruct (LEM A).
  apply H.
  apply H0.
  apply H.
  apply H.
Qed.

(***************************************************)
(* De Morgan\u2019s Laws *)

Hypothesis LEM : forall P : Prop, P \/ ~P.

Lemma q8 : ~(A \/ B) -> ~A /\ ~B.
Proof.
  intro.
  unfold "~" in *.
  split.
  intros.
  apply H.
  left.
  apply H0.
  intros.
  apply H.
  right.
  apply H0.
Qed.

Lemma q9 : ~A /\ ~B -> ~(A \/ B).
Proof.
  intros.
  unfold "~" in *.
  destruct H.
  intros.
  apply H.
  destruct H.
  destruct H1.
  apply H.
  destruct H0.
  apply H.
Qed.

Lemma q10 : ~A \/ ~B -> ~(A /\ B).
Proof.
  intros.
  unfold "~" in *.
  destruct H.
  intros.
  apply H.
  destruct H.
  destruct H0.
  apply H.
  intro.
  destruct H.
  destruct H0.
  apply H0.
Qed.

Lemma q11 : ~(A /\ B) -> ~ A \/ ~ B.
Proof.
  intros.
  unfold "~" in *.
  destruct (LEM A).
  right.
  intros.
  apply H.
  split.
  destruct H.
  split.
  apply H0.
  apply H1.
  apply H1.
  left.
  apply H0.
Qed.

End CoqLab02.